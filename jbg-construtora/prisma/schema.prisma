// Banco de dados do Simulador Habitacional JBG Construtora
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cliente {
  id                 String   @id @default(cuid())
  nomeCompleto       String
  cpf                String?  @unique
  email              String?
  telefone           String?
  dataNascimento     DateTime?
  produtoInteresse   String?
  valorImovel        Float?
  empreendimento     String?
  rendaBruta         Float?
  tipoRenda          String?
  possuiRestricao    String?
  possuiLote         String?
  bairroLote         String?
  possuiFilhos       String?
  funcionarioPublico String?
  categoriaEspecial  String?
  tresAnosFgts       String?
  historicoClt       String?
  estadoCivil        String?
  cpfConjuge         String?
  conjugePossuiRenda String?
  tipoRendaConjuge   String?
  rendaConjuge       Float?
  status             String   @default("Novo")
  origem             String   @default("Formulário de Captação")
  observacoes        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  simulacoes  Simulacao[]
  anexos      AnexoCliente[]
  mensagens   MensagemWhatsapp[]
  respostas   RespostaFormulario[]
}

model Simulacao {
  id              String   @id @default(cuid())
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  operacao        String?
  modalidade      String?
  valorImovel     Float?
  renda           Float?
  uf              String?
  faixa           String?
  subsidio        Float?
  valorFinanciado Float?
  entrada         Float?
  parcela         Float?
  prazo           Int?
  jurosNominal    Float?
  jurosEfetivo    Float?
  sistema         String?
  resultadoJson   String?
  createdAt       DateTime @default(now())
}

model AnexoCliente {
  id          String   @id @default(cuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nomeArquivo String
  tipoArquivo String
  url         String
  tamanho     Int?
  dataEnvio   DateTime @default(now())

  @@map("anexos_clientes")
}

model MensagemWhatsapp {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  telefone  String
  mensagem  String
  status    String   @default("enviada")
  retorno   String?
  createdAt DateTime @default(now())
}

model RespostaFormulario {
  id         String   @id @default(cuid())
  clienteId  String?
  cliente    Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  payload    String
  createdAt  DateTime @default(now())
}
